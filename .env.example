# GEMINI_API_KEY: Required for server-side Gemini Vision food component detection.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Vision-capable Gemini model name read dynamically on the server.
GEMINI_MODEL="gemini-4-hydrogen"

# APP_URL / NEXT_PUBLIC_APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# USDA_FDC_API_KEY: Optional API key for live USDA FoodData Central queries (falls back to verified TKPI + USDA reference dataset when unconfigured).
USDA_FDC_API_KEY=""

# TELEGRAM_BOT_TOKEN & TELEGRAM_WEBHOOK_SECRET: Optional credentials for Telegram Bot integration.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_SECRET=""
TELEGRAM_BOT_USERNAME=""

# WHATSAPP_*: Optional credentials for official WhatsApp Business Cloud API integration.
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""

# CRON_SECRET: Secret token protecting /api/cron/reports from unauthorized execution.
CRON_SECRET=""
